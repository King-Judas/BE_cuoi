@model BE_cuoi.Models.Product
@{
    ViewBag.Title = Model.ProductName + " - KING Game Store";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container py-5 text-light">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="text-info text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item active text-muted" aria-current="page">@Model.ProductName</li>
        </ol>
    </nav>

    <div class="row g-5">
        <!-- Cột ảnh bìa game (Khớp với cột CoverImage trong Database) -->
        <div class="col-lg-7">
            <div class="card bg-dark border-secondary overflow-hidden shadow-lg rounded-4">
                <img src="@Url.Content(string.IsNullOrEmpty(Model.CoverImage) ? "~/Images/default-game.jpg" : Model.CoverImage)"
                     alt="@Model.ProductName"
                     class="w-100"
                     style="height: 400px; object-fit: cover;" />
            </div>
        </div>

        <!-- Cột thông tin chi tiết game -->
        <div class="col-lg-5">
            <h1 class="fw-bold text-white mb-2">@Model.ProductName</h1>
            <span class="badge bg-info text-dark fw-bold mb-3 px-3 py-2">DIGITAL KEY / PC STEAM</span>

            <div class="fs-3 fw-bold text-warning mb-4">
                @string.Format("{0:N0} đ", Model.Price)
            </div>

            <p class="text-muted mb-4" style="line-height: 1.6;">
                @(string.IsNullOrEmpty(Model.Description) ? "Tựa game hành động bom tấn bản quyền, trải nghiệm đồ họa đỉnh cao và cốt truyện cuốn hút." : Model.Description)
            </p>

            <div class="p-3 rounded-3 mb-4" style="background: #151B26; border: 1px solid #263042;">
                <div class="small text-muted mb-1">🎮 Trạng thái kho hàng:</div>
                <div class="fw-bold text-success">✔ Sẵn sàng giao Key tự động qua Email (Tồn kho: @Model.StockQuantity)</div>
            </div>

            <!-- Form Thêm vào giỏ hàng -->
            @using (Html.BeginForm("AddToCart", "Cart", FormMethod.Post))
            {
                @Html.Hidden("productId", Model.ProductID)
                <div class="d-flex align-items-center gap-3 mb-4">
                    <label class="fw-semibold text-muted">Số lượng:</label>
                    <input type="number" name="quantity" value="1" min="1" max="@(Model.StockQuantity > 0 ? Model.StockQuantity : 10)" class="form-control bg-dark text-white border-secondary text-center" style="width: 80px;" />
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-lg fw-bold" style="background: #00E5FF; color: #0B0E14;">
                        🛒 THÊM VÀO GIỎ HÀNG
                    </button>
                </div>
            }
        </div>
    </div>
</div>