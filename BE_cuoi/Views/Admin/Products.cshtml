@model IEnumerable<BE_cuoi.Models.Product>
@{
    ViewBag.Title = "Quản Lý Sản Phẩm - Admin Panel";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container py-5 text-light">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">🛠️ QUẢN LÝ DANH SÁCH GAME</h2>
        <a href="@Url.Action("CreateProduct", "Admin")" class="btn fw-bold px-4" style="background: #00E5FF; color: #0B0E14;">
            ➕ Thêm Game Mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card bg-dark border-secondary rounded-4 p-3 shadow-sm">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr class="text-muted border-secondary">
                        <th>ID</th>
                        <th>Ảnh bìa</th>
                        <th>Tên Game</th>
                        <th>Giá</th>
                        <th class="text-center">Tồn kho</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ProductID</td>
                            <td>
                                <img src="@Url.Content(string.IsNullOrEmpty(item.CoverImage) ? "~/Images/default-game.jpg" : item.CoverImage)"
                                     alt="" style="width: 60px; height: 35px; object-fit: cover; border-radius: 4px;" />
                            </td>
                            <td class="fw-bold text-white">@item.ProductName</td>
                            <td class="text-warning">@string.Format("{0:N0} đ", item.Price)</td>
                            <td class="text-center fw-bold @(item.StockQuantity > 0 ? "text-success" : "text-danger")">@item.StockQuantity</td>
                            <td class="text-center">
                                <a href="@Url.Action("EditProduct", "Admin", new { id = item.ProductID })" class="btn btn-sm btn-outline-info me-1">✏️ Sửa</a>
                                <a href="@Url.Action("DeleteProduct", "Admin", new { id = item.ProductID })" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa game này khỏi hệ thống?');">🗑️ Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>