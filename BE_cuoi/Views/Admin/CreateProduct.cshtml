@model BE_cuoi.Models.Product
@{
    ViewBag.Title = "Thêm Trò Chơi Mới - Admin Panel";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container py-5 text-light" style="max-width: 700px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-info">➕ THÊM TỰA GAME MỚI</h2>
        <a href="@Url.Action("Products", "Admin")" class="btn btn-outline-secondary btn-sm">← Quay lại danh sách</a>
    </div>

    @using (Html.BeginForm("CreateProduct", "Admin", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="card bg-dark border-secondary rounded-4 p-4 shadow-sm">
            <div class="mb-3">
                <label class="form-label text-muted fw-semibold">Tên Trò Chơi:</label>
                @Html.TextBoxFor(m => m.ProductName, new { @class = "form-control bg-dark text-white border-secondary", required = "required", placeholder = "Nhập tên tựa game..." })
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label text-muted fw-semibold">Giá Bán (VNĐ):</label>
                    @Html.TextBoxFor(m => m.Price, new { @class = "form-control bg-dark text-white border-secondary", type = "number", required = "required", placeholder = "Ví dụ: 500000" })
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label text-muted fw-semibold">Số Lượng Tồn Kho:</label>
                    @Html.TextBoxFor(m => m.StockQuantity, new { @class = "form-control bg-dark text-white border-secondary", type = "number", required = "required", Value = "10" })
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label text-muted fw-semibold">Đường Dẫn Ảnh Bìa (CoverImage):</label>
                @Html.TextBoxFor(m => m.CoverImage, new { @class = "form-control bg-dark text-white border-secondary", placeholder = "~/Images/game-name.jpg hoặc đường dẫn ảnh..." })
            </div>

            <div class="mb-4">
                <label class="form-label text-muted fw-semibold">Mô Tả Chi Tiết:</label>
                @Html.TextAreaFor(m => m.Description, new { @class = "form-control bg-dark text-white border-secondary", rows = 4, placeholder = "Nhập thông tin cốt truyện, cấu hình game..." })
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn fw-bold px-4 flex-grow-1" style="background: #00E5FF; color: #0B0E14;">💾 LƯU GAME MỚI</button>
                <a href="@Url.Action("Products", "Admin")" class="btn btn-outline-danger px-4">Hủy bỏ</a>
            </div>
        </div>
    }
</div>