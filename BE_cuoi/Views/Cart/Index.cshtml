@model IEnumerable<BE_cuoi.Models.CartItem>
@{
    ViewBag.Title = "Giỏ Hàng - KING Game Store";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    decimal totalGeneral = 0;
}

<div class="container py-5 text-light">
    <h2 class="fw-bold mb-4">🛒 GIỎ HÀNG CỦA BẠN</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5" style="background: #151B26; border-radius: 12px; border: 1px dashed #334155;">
            <h4 class="text-muted mb-3">Giỏ hàng của bạn đang trống.</h4>
            <a href="@Url.Action("Index", "Home")" class="btn fw-bold px-4" style="background: #00E5FF; color: #0B0E14;">
                KHÁM PHÁ NGAY TỰA GAME HOT
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card bg-dark border-secondary rounded-4 p-3 shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0">
                            <thead>
                                <tr class="text-muted border-secondary">
                                    <th>Tựa Game</th>
                                    <th>Đơn giá</th>
                                    <th class="text-center">Số lượng</th>
                                    <th>Thành tiền</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    decimal subTotal = item.Quantity * item.Product.Price;
                                    totalGeneral += subTotal;
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@Url.Content(string.IsNullOrEmpty(item.Product.CoverImage) ? "~/Images/default-game.jpg" : item.Product.CoverImage)"
                                                     alt="@item.Product.ProductName" style="width: 80px; height: 45px; object-fit: cover; border-radius: 4px;" />
                                                <div>
                                                    <h6 class="fw-bold text-white mb-0">@item.Product.ProductName</h6>
                                                    <small class="text-info">PC / Digital Key</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-warning">@string.Format("{0:N0} đ", item.Product.Price)</td>
                                        <td class="text-center fw-bold">@item.Quantity</td>
                                        <td class="fw-bold text-success">@string.Format("{0:N0} đ", subTotal)</td>
                                        <td class="text-center">
                                            <a href="@Url.Action("RemoveFromCart", "Cart", new { id = item.CartItemID })" class="btn btn-sm btn-outline-danger">
                                                🗑️ Xóa
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Khung tổng thanh toán -->
            <div class="col-lg-4">
                <div class="card bg-dark border-secondary rounded-4 p-4 shadow-sm">
                    <h4 class="fw-bold text-white mb-3">Tóm tắt đơn hàng</h4>
                    <div class="d-flex justify-content-between mb-3 text-muted">
                        <span>Tạm tính:</span>
                        <span class="text-light fw-bold">@string.Format("{0:N0} đ", totalGeneral)</span>
                    </div>
                    <div class="d-flex justify-content-between mb-4 pb-3 border-bottom border-secondary text-muted">
                        <span>Phí vận chuyển (Key Online):</span>
                        <span class="text-success fw-bold">Miễn phí (0 đ)</span>
                    </div>
                    <div class="d-flex justify-content-between mb-4 fs-5 fw-bold">
                        <span>Tổng cộng:</span>
                        <span class="text-warning">@string.Format("{0:N0} đ", totalGeneral)</span>
                    </div>

                    <!-- Đã sửa đúng từ "Order" thành "Orders" để khớp với OrdersController -->
                    <a href="@Url.Action("Checkout", "Orders")" class="btn btn-lg w-100 fw-bold shadow" style="background: #10B981; color: #FFF;">
                        🚀 TIẾN HÀNH THANH TOÁN
                    </a>
                </div>
            </div>
        </div>
    }
</div>