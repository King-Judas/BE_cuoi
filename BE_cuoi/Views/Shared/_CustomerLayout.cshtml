<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - KING Game Store</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <style>
        body {
            background-color: #0B0E14;
            color: #E2E8F0;
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-custom {
            background-color: #151B26;
            border-bottom: 1px solid #263042;
        }

        footer {
            background-color: #151B26;
            border-top: 1px solid #263042;
            margin-top: auto;
            padding: 20px 0;
            color: #94A3B8;
            text-align: center;
        }
    </style>
</head>
<body>
    <!-- HEADER / NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom px-4 sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold text-info" href="@Url.Action("Index", "Home")">👑 KING Game Store</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")">Trang Chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("MyOrder", "Orders")">Đơn Hàng Của Tôi</a>
                    </li>
                    @if (Session["UserID"] != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-semibold" href="@Url.Action("Products", "Admin")">🛠️ Quản Trị Admin</a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav ms-auto align-items-center gap-3">
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-info btn-sm px-3 fw-bold">
                            🛒 Giỏ Hàng
                        </a>
                    </li>
                    @if (Session["UserID"] == null)
                    {
                        <li class="nav-item">
                            <a href="@Url.Action("Login", "Account")" class="btn btn-sm btn-light fw-bold text-dark">Đăng Nhập</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item text-muted small">
                            Xin chào, <strong class="text-white">@Session["Username"]</strong>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Logout", "Account")" class="btn btn-sm btn-outline-danger">Đăng Xuất</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- NỘI DUNG CHÍNH -->
    <div class="container my-4 flex-grow-1">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer>
        <div class="container">
            <p class="mb-0">&copy; 2026 - KING Game Store. Nền tảng phân phối Game bản quyền hàng đầu.</p>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>